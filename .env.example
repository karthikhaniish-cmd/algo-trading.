# Algorithmic Trading System - Environment Configuration
# College Final-Year Project

# Environment Mode: development / simulation
ENVIRONMENT=simulation

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./algotrading.db

# Virtual Simulation Defaults
DEFAULT_VIRTUAL_CAPITAL=10000.0
DEFAULT_TRANSACTION_FEE_PCT=0.1
DEFAULT_SLIPPAGE_PCT=0.05

# Optional External Market Data Provider API Key
# If left commented or empty string, the system runs 100% offline using CSV uploads and synthetic Brownian Motion
MARKET_DATA_API_KEY=PLACEHOLDER_KEY

# Server Secret Key
SECRET_KEY=college_algo_trading_secret_key_change_in_production
